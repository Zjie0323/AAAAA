# ============================================================
#  MCP 订阅推送服务 · 环境变量模板
#
#  用法：复制为同目录下的 .env 并填入真实值
#      cp .env.example .env
#
#  .env 已被 .gitignore 排除，不会进入版本库。
# ============================================================

# ── 鉴权配置（任选一种） ──

# 方式一：直接使用管理端 token（优先级更高）
# ADMIN_TOKEN=xxxx.yyyy

# 方式二：用户名 + 密码自动登录
#   密码支持「明文」或「sha256 hex」两种写法
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 可选 ──

# 自建后端地址（默认即为下列值，内网部署时改为内网地址）
# API_BASE_URL=https://test.yaohaiqing.top/api
